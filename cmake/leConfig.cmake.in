@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@LE_PACKAGE_NEEDS_UTF8PROC@ AND NOT TARGET PkgConfig::UTF8PROC)
    find_dependency(PkgConfig)
    pkg_check_modules(UTF8PROC REQUIRED IMPORTED_TARGET libutf8proc)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/leTargets.cmake")
check_required_components(le)
